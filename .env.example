# Axion Freeroam Environment Variables
# Kopeeri see fail .env-iks ja täida oma väärtustega

# Discord Bot Token (Discord Developer Portal-st)
AXION_DISCORD_BOT_TOKEN=your_bot_token_here

# Gmail seadistus (parooli taastamise meilide jaoks)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# Server seadistus
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
